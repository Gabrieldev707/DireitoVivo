# === Supabase (base de conhecimento) ===
# URL do projeto e chave publicável (leitura da base de conhecimento).
SUPABASE_URL=
SUPABASE_CHAVE_PUBLICA=
# Chave service_role — necessária SOMENTE para os scripts de seed/embeddings (escrita).
# Nunca usar no frontend. Obter em: Supabase Dashboard > Settings > API keys.
SUPABASE_CHAVE_SERVICO=

# === LLM (provedor padrão do MVP: Gemini, tier free) ===
# Obter em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Provedor ativo (por enquanto só "gemini"; a abstração existe pra facilitar troca futura)
LLM_PROVEDOR=gemini
# Modelos.
# O chat é o gargalo do tier free: cada turno de conversa gasta 2 chamadas
# (1 embedding da consulta + 1 geração). Modelos "flash-lite" têm cota por
# minuto mais folgada que os "flash" cheios, o que permite rodar os perfis de
# aceite em sequência sem tomar 429.
# Confira os modelos que a SUA chave enxerga (a disponibilidade muda e alguns
# ficam restritos a contas antigas):
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODELO_CHAT=gemini-3.5-flash-lite
GEMINI_MODELO_EMBEDDING=gemini-embedding-001

# === API ===
# Modo público autorizado nesta etapa: demo. "producao" real permanece bloqueado.
MODO_APLICACAO=desenvolvimento
API_PORTA=3333
# Origem permitida no CORS (frontend em dev)
API_ORIGEM_PERMITIDA=http://localhost:5173
# URL pública da API quando frontend e backend estiverem em projetos separados.
# Vazio no desenvolvimento local, onde o Vite usa proxy para /api.
VITE_API_URL=

# === Limite de uso (protege a cota do provedor LLM) ===
# O free tier do Gemini dá 5 req/min por modelo: sem limite, um único cliente
# abusivo derruba o serviço para todos. Em tier pago, evita custo descontrolado.
API_LIMITE_REQUISICOES=20
API_LIMITE_JANELA=5 minutes
# Sal do hash usado como chave do limite. Troque por um valor aleatório em produção:
# a chave é o hash do IP + sal, então o sal impede correlacionar clientes entre deploys.
API_SAL_LIMITE=troque-por-um-valor-aleatorio
